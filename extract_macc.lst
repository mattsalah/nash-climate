2202   
2203  * --- SCALAR PARAMETERS ---
2204  PARAMETERS
2205      expcost2  / 2.8 /
2206      pback     / 550    /
2207      gback     / 0.025    /
2208  ;
2209   
2210  PARAMETER coefn(coef) / c0 0, c1 1, c2 2, c3 3, c4 4 /;
2211   
2212   
2213  **********************************************
2214  * ----------- MACC CALCULATIONS ---------------
2215  **********************************************
2216   
2217  * --- LOAD RAW DATA ---
2218  PARAMETER macc_ed_coef(sector,*,t,n);
GDXIN   /Users/matthewsalah/Documents/Columbia/2026S/Collective Action/Final Paper/nash-climate/input/RICE50xmodel/data_maxiso3/data_mod_macc.gdx
--- LOAD  macc_ed_coef = 1:macc_ed_coef
2222   
2223  PARAMETER mx_correction_factor(sector,quant,t,n);
GDXIN   /Users/matthewsalah/Documents/Columbia/2026S/Collective Action/Final Paper/nash-climate/input/RICE50xmodel/data_maxiso3/data_mod_macc.gdx
--- LOAD  mx_correction_factor = 3:mx_correction_factor
2227   
2228  * --- COMPUTED PARAMETERS ---
2229  PARAMETERS
2230      pbacktime(t)
2231      macc_coef(t,n,*,coef)
2232      mx(t,n,ghg)
2233      MXpback(t,n,ghg)
2234      MXstart(t,n,ghg)
2235      MXdiff(t,n,ghg)
2236      alpha(t)
2237  ;
2238   
2239  * Map raw enerdata coefficients
2240  macc_coef(t,n,'co2','c1') = macc_ed_coef('Total_CO2','a',t,n);
2241  macc_coef(t,n,'co2','c4') = macc_ed_coef('Total_CO2','d',t,n);
2242  macc_coef(t,n,'co2',coef)$(macc_coef(t,n,'co2',coef) < 0) = 0;
2243   
2244  * Backstop price path
2245  pbacktime(t) = pback * (1-gback)**(tperiod(t)-1);
2246   
2247  * Logistic transition to backstop
2248  SCALAR x0;
2249  x0 = 7 + ((28-7)/2);
2250  alpha(t) = 1 / (1 + exp(-0.25 * (tperiod(t) - x0)));
2251   
2252  * MX starting value (SSP2 default = prob50)
2253  MXstart(t,n,'co2') = mx_correction_factor('Total_CO2','prob50',t,n);
2254   
2255  * Backstop multiplier
2256  MXpback(t,n,'co2')$(macc_ed_coef('Total_CO2','a',t,n) + macc_ed_coef('Total_CO2','d',t,n) > 0)
2257      = pbacktime(t) / (macc_ed_coef('Total_CO2','a',t,n) + macc_ed_coef('Total_CO2','d',t,n));
2258   
2259  MXdiff(t,n,'co2') = max(MXstart(t,n,'co2') - MXpback(t,n,'co2'), 0);
2260   
2261  * Final mx
2262  mx(t,n,'co2') = MXstart(t,n,'co2') - alpha(t) * MXdiff(t,n,'co2');
2263   
2264  * Apply mx to get final scaled coefficients
2265  macc_coef(t,n,'co2','c1') = mx(t,n,'co2') * macc_ed_coef('Total_CO2','a',t,n);
2266  macc_coef(t,n,'co2','c4') = mx(t,n,'co2') * macc_ed_coef('Total_CO2','d',t,n);
2267   
2268   
2269  * --- OUTPUT ---
2270  execute_unload 'output/data/macc_extract.gdx',
2271      macc_ed_coef,
2272      macc_coef,
2273      mx_correction_factor,
2274      mx,
2275      alpha,
2276      pbacktime,
2277      tperiod,
2278      year;
2279   
2280  SET t_early(t) / 1, 2, 3 /;
2281   
2282  FILE fout / 'output/data/macc_ed_early.csv' /;
2283  PUT fout;
2284  PUT '"sector","Dim2","t","n","Val"' /;
2285   
2286  LOOP((t_early(t), n),
2287      PUT '"Total_CO2","a","' t.tl '","' n.tl '",' macc_ed_coef('Total_CO2','a',t,n):0:12 /;
2288      PUT '"Total_CO2","d","' t.tl '","' n.tl '",' macc_ed_coef('Total_CO2','d',t,n):0:12 /;
2289  );
2290   
2291  PUTCLOSE fout;
2292   
2293   
2294   
2295  **********************************************
2296  * ----------- BAU CALCULATIONS ---------------
2297  **********************************************
2298   
2299  *** * --- LOAD BASELINE DATA ---
2300  *** SET ssp / SSP1, SSP2, SSP3, SSP4, SSP5 /;
2301  *** SET ghg2 / co2, ch4, n2o /;
2302  ***
2303  *** PARAMETER ssp_ci(ssp,t,n,ghg2);
2304  *** PARAMETER ssp_ykali(ssp,t,n);
2305  *** PARAMETER convq_ghg(ghg2) / co2 1, ch4 1e-3, n2o 1e-3 /;
2306  ***
2307  *** $gdxin '%datapath%data_baseline'
2308  *** $load ssp_ci
2309  *** $load ssp_ykali
2310  *** $gdxin
2311  ***
2312  *** * --- COMPUTE EMI_BAU FOR SSP2, CO2, t=1,2,3 ---
2313  *** PARAMETER emi_bau_early(t,n);
2314  ***
2315  *** emi_bau_early(t_early,n) = convq_ghg('co2')
2316  ***                           * ssp_ci('SSP2', t_early, n, 'co2')
2317  ***                           * ssp_ykali('SSP2', t_early, n);
2318  ***
2319  *** * --- WRITE TO CSV ---
2320  *** FILE fout2 / 'output/data/emi_bau_early.csv' /;
2321  *** PUT fout2;
2322  *** PUT '"t","n","emi_bau_GtCO2yr"' /;
2323  ***
2324  *** LOOP((t_early(t), n),
2325  ***     PUT '"' t.tl '","' n.tl '",' emi_bau_early(t,n):0:12 /;
2326  *** );
2327  ***
2328  *** PUTCLOSE fout2;
